# Anthropic API Key for AI generation
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# API Keys (comma-separated for multiple keys)
# Format: sk-xxxxxxxxxxxx (minimum 20 characters)
API_KEYS=sk-stylesstealer-test-key-12345678,sk-stylesstealer-prod-key-87654321

# Rate Limiting Configuration
RATE_LIMIT_PER_HOUR=10          # Requests per hour per IP (unauthenticated)
RATE_LIMIT_API_KEY=100          # Requests per hour per API key
RATE_LIMIT_GLOBAL=50            # Global requests per minute (DDoS protection)

# Environment
NODE_ENV=production             # production, development, or test
